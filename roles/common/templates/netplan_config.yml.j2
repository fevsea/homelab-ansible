# Netplan configuration for {{ ansible_hostname }}
# Generated by Ansible - DO NOT EDIT MANUALLY
network:
  version: 2
  renderer: networkd
  ethernets:
    {{ interface }}:
      addresses: [{{ ip }}/24]
      routes:
        - to: default
          via: {{ gateway }}
      nameservers:
        addresses: {{ dns_servers | to_json }}
      dhcp4: false
      dhcp6: false
