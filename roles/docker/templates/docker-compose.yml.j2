# Docker Compose file for {{ compose_name }}
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
---
version: '3.8'

services:
{% for service in compose_data %}
  {{ service.name }}:
    image: {{ service.image }}:{{ service.tag | default('latest') }}
    restart: unless-stopped
    container_name: {{ service.name }}
{% if service.ports is defined and service.ports | length > 0 %}
    ports:
{% for port in service.ports %}
      - "{{ port }}"
{% endfor %}
{% endif %}
{% if service.volumes is defined and service.volumes | length > 0 %}
    volumes:
{% for key, value in service.volumes.items() %}
      - "{{ key }}:{{ value }}"
{% endfor %}
{% endif %}
{% if service.env is defined and service.env | length > 0 %}
    environment:
{% for key, value in service.env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if timezone is defined %}
      TZ: "{{ timezone }}"
{% endif %}
{% if service.networks is defined and service.networks | length > 0 %}
    networks:
{% for network in service.networks %}
      - {{ network }}
{% endfor %}
{% endif %}
{% if service.depends_on is defined and service.depends_on | length > 0 %}
    depends_on:
{% for dependency in service.depends_on %}
      - {{ dependency }}
{% endfor %}
{% endif %}
{% if service.healthcheck is defined %}
    healthcheck:
      test: {{ service.healthcheck.test | to_json }}
      interval: {{ service.healthcheck.interval | default('30s') }}
      timeout: {{ service.healthcheck.timeout | default('10s') }}
      retries: {{ service.healthcheck.retries | default(3) }}
{% endif %}

{% endfor %}

volumes:
{% for service in compose_data %}
{% if service.volumes is defined and service.volumes | length > 0 %}
{% for key, value in service.volumes.items() %}
  {{ key }}:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ docker_volumes_path }}/{{ compose_name }}/{{ key }}"
{% endfor %}
{% endif %}
{% endfor %}

{% if networks is defined and networks | length > 0 %}
networks:
{% for network in networks %}
  {{ network.name }}:
{% if network.driver is defined %}
    driver: {{ network.driver }}
{% endif %}
{% if network.ipam is defined %}
    ipam:
      config:
        - subnet: {{ network.ipam.subnet }}
{% endif %}
{% endfor %}
{% endif %}
